# =============================================================================
# Medipedia frontend environment
#
# These same four variables MUST also be set in the Vercel dashboard
# (Project -> Settings -> Environment Variables -> Production + Preview).
# Vercel does not always read a committed .env, and if NEXTAUTH_SECRET is
# missing at runtime every protected page bounces back to /login.
# =============================================================================

# Signs the session JWT. Was "123456780" — short enough to brute-force, which
# would let anyone mint a valid session cookie for any account.
# Changing it logs everyone out once; that is expected and safe.
# Regenerate with:  openssl rand -base64 32
NEXTAUTH_SECRET=GgxQlf5Ie9VcmNhMhS/FDtFgZO/SOOqhbqghlPOMahI=

# Canonical public URL of this site. No trailing slash.
NEXTAUTH_URL=https://medipedia-web.vercel.app
SITE_URL=https://medipedia-web.vercel.app

# PHP API on SiteGround. No trailing slash.
NEXT_PUBLIC_API_URL=https://medipedia-web-api.desired-techs.com
