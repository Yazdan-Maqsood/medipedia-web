# Copy to .env (local) and set the same values in the Vercel dashboard.

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-32-byte-random-string

# Canonical public URL of the site. No trailing slash.
NEXTAUTH_URL=https://medipedia-web.vercel.app
SITE_URL=https://medipedia-web.vercel.app

# PHP API base URL. No trailing slash.
NEXT_PUBLIC_API_URL=https://medipedia-web-api.desired-techs.com
